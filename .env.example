# ============================================
# Arquivo de Exemplo de VariÃ¡veis de Ambiente
# ============================================
# 
# INSTRUÃ‡Ã•ES:
# 1. Copie este arquivo para .env (nÃ£o serÃ¡ commitado)
# 2. Preencha os valores reais
# 3. NUNCA commite o arquivo .env com valores reais!
#
# Para usar: cp .env.example .env
# (ou no Windows: copy .env.example .env)
# ============================================

# ============================================
# ConfiguraÃ§Ã£o do Banco de Dados
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=snackbar_db
DB_USERNAME=snackbar_user
DB_PASSWORD=sua-senha-segura-aqui
DB_URL=jdbc:mysql://localhost:3306/snackbar_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo

# Para Docker Compose (desenvolvimento)
MYSQL_PORT=3307

# ============================================
# ConfiguraÃ§Ã£o do Backend
# ============================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ============================================
# JWT (JSON Web Token)
# ============================================
# IMPORTANTE: Use uma string segura com pelo menos 256 bits (32 caracteres)
# Em produÃ§Ã£o, gere uma chave aleatÃ³ria forte
JWT_SECRET=sua-chave-jwt-secreta-minimo-256-bits-aqui
JWT_EXPIRATION=86400

# ============================================
# Logging e Debug
# ============================================
SHOW_SQL=false
LOG_LEVEL=INFO
# Para desenvolvimento: LOG_LEVEL=DEBUG

# ============================================
# Google OAuth (opcional, para login de clientes)
# ============================================
GOOGLE_CLIENT_ID=seu-google-client-id-aqui

# ============================================
# Gemini no Vertex AI - Chat IA (Assistente Soneca)
# ============================================
# Autentica pela chave da conta de serviço em ./secrets/vertex-sa.json (nunca no .env)
# Passo a passo: docs/runbooks/chat-ia-gemini-vertex.md
GEMINI_PROJECT_ID=seu-projeto-gcp
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS_FALLBACK=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=4000

# ============================================
# Variáveis para Scripts PowerShell de Teste
# ============================================
# Usadas pelos scripts testar-login.ps1 e verificar-backend.ps1
TEST_EMAIL=admin@snackbar.com
TEST_SENHA=sua-senha-de-teste-aqui

# ============================================
# Docker / Ambiente de Desenvolvimento
# ============================================
NODE_ENV=development
DOCKER_ENV=false

# ============================================
# Backend URL (para proxy do frontend)
# ============================================
BACKEND_URL=http://localhost:8080

# ============================================
# Pagamentos integrados (gateway plugavel)
# ============================================
# Master switch da feature de pagamentos (PIX/cartao digital/TEF)
PAGAMENTO_ENABLED=false
# Gateway do PIX digital: SIMULADO | GETNET (STONE reservado para o futuro)
PAGAMENTO_GATEWAY_PIX=SIMULADO
# Validade do QR Code PIX em segundos
PAGAMENTO_PIX_EXPIRACAO_SEGUNDOS=180
# Credenciais Getnet (sandbox: https://api-homologacao.getnet.com.br)
GETNET_BASE_URL=https://api-homologacao.getnet.com.br
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_SELLER_ID=
# Token exigido no header X-Webhook-Token dos webhooks Getnet
GETNET_WEBHOOK_TOKEN=
# Secret HMAC do webhook PIX simulado/Stone (vazio = aceito so com gateway SIMULADO)
PAGAMENTO_SIMULADO_WEBHOOK_SECRET=

# ============================================
# Electron Totem (autoatendimento)
# ============================================
TOTEM_URL=http://localhost:4200/autoatendimento
TOTEM_FULLSCREEN_ENABLED=true
TOTEM_KIOSK_ENABLED=false
TOTEM_MOBILE_EMULATION_ENABLED=true
TOTEM_VIRTUAL_KEYBOARD_ENABLED=true
TOTEM_TEF_MOCK_ENABLED=true
TOTEM_TEF_MOCK_RESULT=APROVADO
TOTEM_TEF_MOCK_DELAY_MS=1200
