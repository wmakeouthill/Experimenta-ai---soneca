# ============================================================
# Variáveis de Ambiente - PRODUÇÃO
# ============================================================
# IMPORTANTE: Copie este arquivo para .env.prod e preencha
# NUNCA commite o .env.prod no repositório!
# ============================================================

# ==================== DOMÍNIO ====================
DOMAIN=experimentaaisoneca.app

# ==================== MYSQL ====================
DB_ROOT_PASSWORD=TROCAR_SENHA_ROOT_FORTE_AQUI
DB_NAME=snackbar_db
DB_USERNAME=snackbar_user
DB_PASSWORD=TROCAR_SENHA_USER_FORTE_AQUI

# ==================== JWT ====================
# Gere com: openssl rand -base64 64
JWT_SECRET=TROCAR_JWT_SECRET_MINIMO_256_BITS
JWT_EXPIRATION=86400

# ==================== LOGS ====================
LOG_LEVEL=WARN

# ==================== GITHUB CONTAINER REGISTRY ====================
GHCR_USER=wmakeouthill
TAG=latest

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=105501776132-75qp7j87btik9423dk3eus1ueu4au5il.apps.googleusercontent.com

# ==================== CHAT IA (OPCIONAL) ====================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000

# ==================== PAGAMENTO TOTEM (STONE) ====================
PAGAMENTO_TOTEM_ENABLED=false
STONE_PIX_MOCK_ENABLED=false
STONE_PIX_BASE_URL=https://api.openbank.stone.com.br
STONE_PIX_CLIENT_ID=
STONE_PIX_CLIENT_SECRET=
STONE_PIX_ACCOUNT_ID=
STONE_PIX_WEBHOOK_SECRET=
STONE_PIX_EXPIRACAO_SEGUNDOS=300

# ============================================
# Electron Totem (autoatendimento)
# ============================================
TOTEM_URL=https://experimentaaisoneca.app/autoatendimento
TOTEM_FULLSCREEN_ENABLED=true
TOTEM_KIOSK_ENABLED=true
TOTEM_MOBILE_EMULATION_ENABLED=true
TOTEM_VIRTUAL_KEYBOARD_ENABLED=true
TOTEM_TEF_MOCK_ENABLED=false
TOTEM_TEF_MOCK_RESULT=APROVADO
TOTEM_TEF_MOCK_DELAY_MS=1200
